# Defaults to SQLite in the working directory. docker-compose sets Postgres for you.
# DATABASE_URL=postgresql://user:pass@host:5432/asli

# Random string used to hash IPs and phone numbers for rate limiting
HASH_SALT=change-me

# Set to 0 to stop saving checks entirely
STORE_CHECKS=1
RATE_LIMIT_PER_MINUTE=20

# WhatsApp Cloud API (see README). Leave blank to run without WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=
